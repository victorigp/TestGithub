{
  "build": {
    "content": [
      {
        "files": [
          "**.md",
          "toc.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "coverage/**",
          "allure-report/**"
        ]
      }
    ],
    "dest": "_site",
    "postProcessors": [
      "ExtractSearchIndex"
    ],
    "globalMetadata": {
      "_appName": "TestGithub Docs",
      "_appTitle": "TestGithub - Documentación Técnica",
      "_enableSearch": true
    }
  }
}
